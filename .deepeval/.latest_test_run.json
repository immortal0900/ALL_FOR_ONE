{"testRunData": {"testFile": "src/tests/judge/judge_eval/test_judge.py", "testCases": [{"name": "test_judge_accuracy", "input": "[\ud544\uc218 \uad6c\uc870]\n1. \uac1c\uc694\n2. \uc815\ucc45 \ubaa9\ud45c\n3. \uc8fc\uc694 \uc815\ucc45 \ube44\uad50(10\uac1c \ud56d\ubaa9: \uc8fc\ub2f4\ub300, \ub2e4\uc8fc\ud0dd\uc790, \uc2e4\uac70\uc8fc...)\n4. \uc8fc\uc694 \ucc28\uc774\uc810 \uc694\uc57d\n5. \ud3c9\uac00 \ubc0f \ubc18\uc751\n[\ubcf4\uace0\uc11c \ucd08\uc548]\n## \uac1c\uc694\n\uc7ac\uac74\ucd95 \uc644\ud654 \uc815\ucc45\uc785\ub2c8\ub2e4.\n## \uc815\ucc45 \ubaa9\ud45c\n\uc548\uc804\uc9c4\ub2e8 \ud1b5\uacfc\uc728\uc744 \ub192\uc785\ub2c8\ub2e4.\n## 3. \uc8fc\uc694 \uc815\ucc45 \ube44\uad50\n- \uc8fc\ub2f4\ub300: LTV 70%\n- \ub2e4\uc8fc\ud0dd\uc790: \ucde8\ub4dd\uc138 \uc911\uacfc \uc644\ud654", "actualOutput": "{\"is_complete\": false, \"missing_sections\": [\"\uc8fc\uc694 \uc815\ucc45 \ube44\uad50(\uc2e4\uac70\uc8fc \uc758\ubb34, \uc0dd\uc560\ucd5c\ucd08 \uc8fc\ud0dd\uad6c\uc785\uc790 \uaddc\uc81c, \uaddc\uc81c\uc9c0\uc5ed \uc9c0\uc815, DSR \uaddc\uc81c, \uc804\uc138\ub300\ucd9c, \uac00\uacc4\ub300\ucd9c \ucd1d\ub7c9, \uc0dd\ud65c\uc548\uc815\uc790\uae08 \uc8fc\ub2f4\ub300, \uc911\ub3c4\uae08 \ub300\ucd9c)\", \"\uc8fc\uc694 \ucc28\uc774\uc810 \uc694\uc57d\", \"\ud3c9\uac00 \ubc0f \ubc18\uc751\", \"\uc804\ub9dd \ubc0f \uacfc\uc81c\", \"\ucc38\uace0 \uc790\ub8cc\"], \"missing_information\": \"3\ubc88 \uc8fc\uc694 \uc815\ucc45 \ube44\uad50\uc5d0\uc11c 1,2\ubc88 \ud56d\ubaa9\ub9cc \uc788\uace0 3~10\ubc88 \ud56d\ubaa9\uc774 \ud1b5\uc9f8\ub85c \ub204\ub77d\ub428. 4~7\ubc88 \ubaa9\ucc28 \uc804\uccb4 \ub204\ub77d.\", \"search_queries\": [\"1.10 \ubd80\ub3d9\uc0b0 \ub300\ucc45 \uc8fc\uc694 \uc815\ucc45 \ube44\uad50 \ub0b4\uc6a9\", \"\uc7ac\uac74\ucd95 \uc644\ud654 \uaddc\uc81c\uc9c0\uc5ed \uc9c0\uc815 DSR \uaddc\uc81c\"]}", "success": false, "metricsData": [{"name": "CritiqueAccuracy [GEval]", "threshold": 0.7, "success": false, "score": 0.6, "reason": "\uac15\uc810: \ucd08\uc548\uc758 3\ubc88(\uc8fc\uc694 \uc815\ucc45 \ube44\uad50)\uc5d0\uc11c \ud56d\ubaa9\uc774 2\uac1c\ub9cc \uc788\uc74c\uc744 \uc815\ud655\ud788 \uc9c0\uc801\ud558\uace0 3~10\ubc88 \ud56d\ubaa9 \uc804\ubc18\uc774 \ub204\ub77d\ub418\uc5c8\ub2e4\uace0 \uad6c\uccb4\uc801\uc73c\ub85c \uc11c\uc220\ud588\uc73c\uba70, \ub204\ub77d \ubcf4\uc644\uc6a9 \uac80\uc0c9\uc5b4\ub3c4 \uc81c\uc2dc\ud568. \uc57d\uc810: \ud3c9\uac00 \ud56d\ubaa9\uc5d0\uc11c \uc6d0\ubcf8 \ud544\uc218 \ubaa9\ub85d\uc5d0 \uc5c6\ub358 '\uc804\ub9dd \ubc0f \uacfc\uc81c', '\ucc38\uace0 \uc790\ub8cc'\ub97c \ucd94\uac00\ub85c \ub204\ub77d\uc73c\ub85c \uc9c0\uc801\ud55c \uac83\uc740 \uacfc\uc789\ube44\ud310\uc774\uba70(Over-critique), '4~7\ubc88 \ubaa9\ucc28 \uc804\uccb4 \ub204\ub77d'\uc774\ub77c\uace0 \ud55c \uc9c4\uc220\uc740 \uc6d0\ubcf8\uc5d0 4~5\ubc88\uae4c\uc9c0\ub9cc \uc874\uc7ac\ud558\ubbc0\ub85c \ubd80\uc815\ud655\ud568. \uac80\uc0c9\uc5b4 \uc911 \uc77c\ubd80 \ud45c\ud604(\uc608: \"1.10 \ubd80\ub3d9\uc0b0 \ub300\ucc45...\")\uc774 \ub2e4\ub4ec\uc5b4\uc9c0\uc9c0 \uc54a\uc74c.", "strictMode": false, "evaluationModel": "gpt-5-mini", "verboseLogs": "Criteria:\nNone \n \nEvaluation Steps:\n[\n    \"[\uac00\uc810] \uc6d0\ubcf8 \ucd08\uc548(draft)\uc5d0\uc11c \uc2e4\uc81c\ub85c \ub204\ub77d\ub41c \ud544\uc218 \ubaa9\ucc28\ub97c `missing_sections`\uc5d0 \uc815\ud655\ud788 \uc9c0\uc801\ud55c \uacbd\uc6b0 \ub192\uc740 \uc810\uc218\",\n    \"[\uac10\uc810] \ucd08\uc548\uc5d0 \uc774\ubbf8 \uc874\uc7ac\ud558\ub294 \ub0b4\uc6a9\uc744 \ub204\ub77d\ub418\uc5c8\ub2e4\uace0 \uc798\ubabb \uc9c0\uc801(Over-critique)\ud55c \uacbd\uc6b0 \uac10\uc810\",\n    \"[\uac10\uc810] \ucd08\uc548\uc5d0 \uba85\ud655\ud788 \ube60\uc9c4 \ud544\uc218 \ubaa9\ucc28\uac00 \uc788\ub294\ub370\ub3c4 \ucc3e\uc544\ub0b4\uc9c0 \ubabb\ud55c(Under-critique) \uacbd\uc6b0 \ud06c\uac8c \uac10\uc810\",\n    \"[\uac00\uc810] `missing_information`\uc5d0 \ub204\ub77d\ub41c \uc218\uce58\ub098 \ub514\ud14c\uc77c\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc11c\uc220\ud55c \uacbd\uc6b0 \uac00\uc810\",\n    \"[\uac00\uc810] `search_queries`\uac00 \ub204\ub77d\ub41c \uc815\ubcf4\ub97c \ucc44\uc6b0\uae30\uc5d0 \uc801\ud569\ud55c \ud0a4\uc6cc\ub4dc\ub85c \uad6c\uc131\ub41c \uacbd\uc6b0 \uac00\uc810\",\n    \"[\ud544\uc218] \ud310\ub2e8 \uc774\uc720\ub294 \ubc18\ub4dc\uc2dc \ud55c\uad6d\uc5b4\ub85c \uc791\uc131\ud560 \uac83\"\n] \n \nRubric:\nNone \n \nScore: 0.6"}], "runDuration": 25.230386900017038, "order": 0}, {"name": "test_judge_accuracy", "input": "[\ud544\uc218 \uad6c\uc870]\n1. \uac1c\uc694\n2. \uc815\ucc45 \ubaa9\ud45c\n3. \uc8fc\uc694 \uc815\ucc45 \ube44\uad50(10\uac1c \ud56d\ubaa9)\n[\ubcf4\uace0\uc11c \ucd08\uc548]\n## 1. \uac1c\uc694\n\uc644\ubcbd\ud55c \uc815\ucc45 \uc124\uba85.\n## 2. \uc815\ucc45 \ubaa9\ud45c\n\uc644\ubcbd\ud55c \ubaa9\ud45c \uc124\uba85.\n## 3. \uc8fc\uc694 \uc815\ucc45 \ube44\uad50\n1~10\ubc88 \ud56d\ubaa9\uc5d0 \ub300\ud55c \ubaa8\ub4e0 \uc218\uce58 \ub370\uc774\ud130 \ud3ec\ud568.", "actualOutput": "{\"is_complete\": true, \"missing_sections\": [], \"missing_information\": \"\", \"search_queries\": []}", "success": false, "metricsData": [{"name": "CritiqueAccuracy [GEval]", "threshold": 0.7, "success": false, "score": 0.4, "reason": "\uac15\uc810: \uc785\ub825\ub41c \ucd08\uc548\uc740 \uc694\uad6c\ub41c 3\uac1c \ud56d\ubaa9(\uac1c\uc694, \uc815\ucc45 \ubaa9\ud45c, \uc8fc\uc694 \uc815\ucc45 \ube44\uad50(10\uac1c \ud56d\ubaa9))\uc744 \ubaa8\ub450 \ud3ec\ud568\ud558\uace0 \uc788\uace0, \uc2e4\uc81c \ucd9c\ub825\uc740 is_complete=true \ubc0f missing_sections=[]\ub85c \uc774\ub97c \uc815\ud655\ud788 \ubc18\uc601\ud574 \uacfc\uc789\ube44\ud310\uc744 \ud558\uc9c0 \uc54a\uc740 \uc810\uc740 \uc801\uc808\ud568. \ub2e8\uc810: \ud3c9\uac00 \ub2e8\uacc4 6\uc740 \ud310\ub2e8 \uc774\uc720\ub97c \ubc18\ub4dc\uc2dc \ud55c\uad6d\uc5b4\ub85c \uc791\uc131\ud560 \uac83\uc744 \uba85\uc2dc\ud558\ub294\ub370 \uc2e4\uc81c \ucd9c\ub825\uc5d0\ub294 \uc124\uba85(reason) \ud544\ub4dc\uac00 \uc804\ud600 \uc5c6\uc5b4 \ud544\uc218 \uc694\uac74\uc744 \ub9cc\uc871\ud558\uc9c0 \ubabb\ud568. \ub610\ud55c \ucd9c\ub825\uc774 \ube48 missing_information\uacfc \ube48 search_queries\ub97c \ubc18\ud658\ud55c \uac83\uc740 \ud569\ub9ac\uc801\uc77c \uc218 \uc788\uc73c\ub098, \u20183. \uc8fc\uc694 \uc815\ucc45 \ube44\uad50\u2019\uc758 10\uac1c \ud56d\ubaa9\u00b7\uc218\uce58\uc5d0 \ub300\ud55c \uad6c\uccb4\uc801 \ud655\uc778\uc774\ub098 \uadfc\uac70\ub97c \uc81c\uc2dc\ud558\uc9c0 \uc54a\uc740 \uc810\ub3c4 \uc544\uc26c\uc6c0.", "strictMode": false, "evaluationModel": "gpt-5-mini", "verboseLogs": "Criteria:\nNone \n \nEvaluation Steps:\n[\n    \"[\uac00\uc810] \uc6d0\ubcf8 \ucd08\uc548(draft)\uc5d0\uc11c \uc2e4\uc81c\ub85c \ub204\ub77d\ub41c \ud544\uc218 \ubaa9\ucc28\ub97c `missing_sections`\uc5d0 \uc815\ud655\ud788 \uc9c0\uc801\ud55c \uacbd\uc6b0 \ub192\uc740 \uc810\uc218\",\n    \"[\uac10\uc810] \ucd08\uc548\uc5d0 \uc774\ubbf8 \uc874\uc7ac\ud558\ub294 \ub0b4\uc6a9\uc744 \ub204\ub77d\ub418\uc5c8\ub2e4\uace0 \uc798\ubabb \uc9c0\uc801(Over-critique)\ud55c \uacbd\uc6b0 \uac10\uc810\",\n    \"[\uac10\uc810] \ucd08\uc548\uc5d0 \uba85\ud655\ud788 \ube60\uc9c4 \ud544\uc218 \ubaa9\ucc28\uac00 \uc788\ub294\ub370\ub3c4 \ucc3e\uc544\ub0b4\uc9c0 \ubabb\ud55c(Under-critique) \uacbd\uc6b0 \ud06c\uac8c \uac10\uc810\",\n    \"[\uac00\uc810] `missing_information`\uc5d0 \ub204\ub77d\ub41c \uc218\uce58\ub098 \ub514\ud14c\uc77c\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc11c\uc220\ud55c \uacbd\uc6b0 \uac00\uc810\",\n    \"[\uac00\uc810] `search_queries`\uac00 \ub204\ub77d\ub41c \uc815\ubcf4\ub97c \ucc44\uc6b0\uae30\uc5d0 \uc801\ud569\ud55c \ud0a4\uc6cc\ub4dc\ub85c \uad6c\uc131\ub41c \uacbd\uc6b0 \uac00\uc810\",\n    \"[\ud544\uc218] \ud310\ub2e8 \uc774\uc720\ub294 \ubc18\ub4dc\uc2dc \ud55c\uad6d\uc5b4\ub85c \uc791\uc131\ud560 \uac83\"\n] \n \nRubric:\nNone \n \nScore: 0.4"}], "runDuration": 24.830529700033367, "order": 1}, {"name": "test_judge_accuracy", "input": "[\ud544\uc218 \uad6c\uc870]\n1. \uac1c\uc694\n2. \uc815\ucc45 \ubaa9\ud45c\n[\ubcf4\uace0\uc11c \ucd08\uc548]\n## \uac1c\uc694\n\uc815\ucc45\uc784.", "actualOutput": "{\"is_complete\": false, \"missing_sections\": [\"\ubaa9\ucc28\ubd80\uc871\"], \"missing_information\": \"\uc804\uccb4\uc801\uc73c\ub85c \ub0b4\uc6a9\uc774 \ub108\ubb34 \uc5c6\uc74c\", \"search_queries\": [\"\ubd80\ub3d9\uc0b0\"]}", "success": false, "metricsData": [{"name": "CritiqueAccuracy [GEval]", "threshold": 0.7, "success": false, "score": 0.2, "reason": "\uc694\uad6c\ub41c \ud544\uc218 \uad6c\uc870\uc5d0\ub294 '\uac1c\uc694'\uc640 '\uc815\ucc45 \ubaa9\ud45c'\uac00 \uc788\uace0 \ubcf4\uace0\uc11c \ucd08\uc548\uc5d0\ub294 '\uac1c\uc694'\ub9cc \uc874\uc7ac\ud568(\ud3c9\uac00 \uae30\uc900\uc758 \ud14c\uc2a4\ud2b8 \ucf00\uc774\uc2a4 \uc815\ubcf4 \ubc18\uc601). Actual Output\uc758 missing_sections\uac00 \uad6c\uccb4\uc801 \uacb0\uc190 \ud56d\ubaa9 \ub300\uc2e0 '\ubaa9\ucc28\ubd80\uc871'\uc73c\ub85c \ubaa8\ud638\ud558\uac8c \ud45c\uae30\ub418\uc5b4 \ud544\uc218 \ub204\ub77d \ud56d\ubaa9('\uc815\ucc45 \ubaa9\ud45c')\uc744 \uc815\ud655\ud788 \uc9c0\uc801\ud558\uc9c0 \ubabb\ud568(\ud3c9\uac00 1,3\uc5d0 \ub530\ub77c \uac10\uc810). \ub610\ud55c missing_information\uc774 '\uc804\uccb4\uc801\uc73c\ub85c \ub0b4\uc6a9\uc774 \ub108\ubb34 \uc5c6\uc74c'\ucc98\ub7fc \uad6c\uccb4 \uc218\uce58\ub098 \ud56d\ubaa9\uc744 \uc81c\uc2dc\ud558\uc9c0 \uc54a\uc544 \ucd94\uac00 \uac00\uc810 \uc694\uac74\uc744 \ucda9\uc871\ud558\uc9c0 \ubabb\ud558\uace0(\ud3c9\uac00 4), search_queries\uc5d0 '\ubd80\ub3d9\uc0b0'\ub9cc \ub2e8\ub3c5 \uae30\uc7ac\ub41c \uac83\uc740 \ub204\ub77d \uc815\ubcf4\ub97c \ubcf4\uc644\ud560 \uc801\ud569\ud55c \ud0a4\uc6cc\ub4dc\ub85c \ubcf4\uae30 \uc5b4\ub824\uc6c0(\ud3c9\uac00 5). \ub2e4\ub9cc \ucd08\uc548\uc5d0 \uc774\ubbf8 \uc788\ub294 '\uac1c\uc694'\ub97c \ub204\ub77d\ub418\uc5c8\ub2e4\uace0 \uc798\ubabb \uc9c0\uc801\ud558\uc9c4 \uc54a\uc544 \uacfc\uc789\ube44\ud310\uc740 \uc5c6\uc74c(\ud3c9\uac00 2).", "strictMode": false, "evaluationModel": "gpt-5-mini", "verboseLogs": "Criteria:\nNone \n \nEvaluation Steps:\n[\n    \"[\uac00\uc810] \uc6d0\ubcf8 \ucd08\uc548(draft)\uc5d0\uc11c \uc2e4\uc81c\ub85c \ub204\ub77d\ub41c \ud544\uc218 \ubaa9\ucc28\ub97c `missing_sections`\uc5d0 \uc815\ud655\ud788 \uc9c0\uc801\ud55c \uacbd\uc6b0 \ub192\uc740 \uc810\uc218\",\n    \"[\uac10\uc810] \ucd08\uc548\uc5d0 \uc774\ubbf8 \uc874\uc7ac\ud558\ub294 \ub0b4\uc6a9\uc744 \ub204\ub77d\ub418\uc5c8\ub2e4\uace0 \uc798\ubabb \uc9c0\uc801(Over-critique)\ud55c \uacbd\uc6b0 \uac10\uc810\",\n    \"[\uac10\uc810] \ucd08\uc548\uc5d0 \uba85\ud655\ud788 \ube60\uc9c4 \ud544\uc218 \ubaa9\ucc28\uac00 \uc788\ub294\ub370\ub3c4 \ucc3e\uc544\ub0b4\uc9c0 \ubabb\ud55c(Under-critique) \uacbd\uc6b0 \ud06c\uac8c \uac10\uc810\",\n    \"[\uac00\uc810] `missing_information`\uc5d0 \ub204\ub77d\ub41c \uc218\uce58\ub098 \ub514\ud14c\uc77c\uc744 \uad6c\uccb4\uc801\uc73c\ub85c \uc11c\uc220\ud55c \uacbd\uc6b0 \uac00\uc810\",\n    \"[\uac00\uc810] `search_queries`\uac00 \ub204\ub77d\ub41c \uc815\ubcf4\ub97c \ucc44\uc6b0\uae30\uc5d0 \uc801\ud569\ud55c \ud0a4\uc6cc\ub4dc\ub85c \uad6c\uc131\ub41c \uacbd\uc6b0 \uac00\uc810\",\n    \"[\ud544\uc218] \ud310\ub2e8 \uc774\uc720\ub294 \ubc18\ub4dc\uc2dc \ud55c\uad6d\uc5b4\ub85c \uc791\uc131\ud560 \uac83\"\n] \n \nRubric:\nNone \n \nScore: 0.2"}], "runDuration": 20.441117299953476, "order": 2}, {"name": "test_extraction", "input": "[\uc6d0\ubcf8 \ub370\uc774\ud130]\n\uc11c\uc6b8>\uac15\ubd81\uc9c0\uc5ed: \ub9e4\ub9e4\uc218\uae09\uc9c0\uc218 105.2\n\uc11c\uc6b8>\uac15\ub0a8\uc9c0\uc5ed: \ub9e4\ub9e4\uc218\uae09\uc9c0\uc218 108.3\n\uc11c\uc6b8>\uac15\ubd81\uc9c0\uc5ed>\ub3c4\uc2ec\uad8c: 102.1\n\uc11c\uc6b8>\uac15\ub0a8\uc9c0\uc5ed>\uc11c\ub0a8\uad8c: 106.5\n\uc11c\uc6b8>\uac15\ub0a8\uc9c0\uc5ed>\ub3d9\ub0a8\uad8c: 112.8\n\uc11c\uc6b8>\uac15\ubd81\uc9c0\uc5ed>\ub3d9\ubd81\uad8c: 104.3\n\uc11c\uc6b8>\uac15\ubd81\uc9c0\uc5ed>\uc11c\ubd81\uad8c: 103.7\n\n[\uc9c8\ubb38]\n\uc704\uc5d0\uc11c \uc11c\uc6b8 \ub3d9\uc791\uad6c\uc5d0 \ub9de\ub294 \uc9c0\uc5ed\